# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Runtime
backend/uploads/*
backend/outputs/*
!backend/uploads/.gitkeep
!backend/outputs/.gitkeep

# Checkpoints — big binaries, not versioned
backend/checkpoints/*.pt

